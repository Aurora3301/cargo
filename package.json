{
  "name": "folio-local",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:app": "npm install",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -H 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -H 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "prepare:hosting": "node scripts/prepare-hosting.mjs",
    "prepare:pages": "node scripts/prepare-pages.mjs",
    "check:pages": "node scripts/prepare-pages.mjs --check"
  },
  "dependencies": {
    "next": "15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
